<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup and device-to-device migration are disabled for Clockwise.

    The Room database contains calendar, alarm, tag and AI chat data, and DataStore holds the
    encrypted AI API-key blobs. The Android Keystore key that decrypts those blobs is never part of
    a backup, so restoring the ciphertext elsewhere cannot work. Excluding every domain keeps both
    the plaintext data and the useless ciphertext off backup transports.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
